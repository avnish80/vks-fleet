# Supervisor API addresses, space or comma separated (the same as the
# "Headlamp cluster for the Supervisor" in settings/config.json).
SUPERVISORS=10.0.0.2
# Which VKS clusters to sign in to: all (every cluster the account can see),
# none (Supervisors only), or a list such as team-a-ns1/kubernetes-cluster-c3d4,team-b-ns1/web
CLUSTERS=all
KUBECONFIG_SECRET=vks-fleet-kubeconfig
HEADLAMP_DEPLOYMENT=headlamp
