MODE=vcfa
VCFA_ENDPOINT=https://auto-a.example.com
# The org's tenant name in VCF Automation (as in `vcf context create … --tenant-name`)
VCFA_TENANT=Org2-CTGW
# Short name used in context names (<label>:<namespace>:<project>); match config.json
VCFA_LABEL=org2
# namespace=urn[@project], comma separated. The URN is the last part of the server
# address in your VCF CLI context:  kubectl config view -o jsonpath='{.clusters[*].cluster.server}'
VCFA_NAMESPACES=team-a-ns1=urn:vcloud:namespace:REPLACE-ME@default-project
# true skips TLS verification: lab certificates only.
VCFA_INSECURE=false
# Optional: the org-level server, so the plugin can read the org's quotas.
# kubectl config view -o jsonpath='{.clusters[?(@.name=="org2:auto-a.example.com")].cluster.server}'
# VCFA_ORG_SERVER=https://auto-a.example.com/…
KUBECONFIG_SECRET=vks-fleet-kubeconfig
HEADLAMP_DEPLOYMENT=headlamp
